# Copy this file to `.env` in the repo root and fill in real values.
# NEVER commit the actual `.env` file. This file only contains placeholders.

# --- App ---
ENV=development

# --- Database ---
# Used by the backend container / local uvicorn run.
DATABASE_URL=postgresql+asyncpg://soc_app:CHANGE_ME_DB_PASSWORD@localhost:5432/soc_platform
POSTGRES_USER=soc_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=soc_platform

# --- Redis (event bus / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Elasticsearch (wired in Part 2) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MFA ---
MFA_ISSUER_NAME=AI-SOC-Platform

# --- Threat Intel feed (OPTIONAL — leave blank to disable, Part 2) ---
# If set, the Part 2 threat-intel importer will pull IOCs from this feed.
# Do NOT put real API keys in source control.
THREAT_INTEL_FEED_URL=
THREAT_INTEL_API_KEY=

# --- Optional AWS log archival (OPTIONAL — this repo does not provision AWS resources) ---
# Only required if you wire up S3 archival yourself; leave blank otherwise.
AWS_S3_ARCHIVE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- CORS (comma-separated origins the frontend is served from) ---
CORS_ORIGINS=http://localhost:5173

# --- Detection rules ---
# Leave unset to use the auto-resolved default (works for both Docker and
# local dev — see backend/app/core/config.py). Override only if your rules
# live somewhere non-standard.
# DETECTION_RULES_PATH=../detection_rules

# --- ML anomaly detection ---
# Leave unset to use the auto-resolved default (backend/ml_models/isoforest.pkl
# locally, /app/ml_models/isoforest.pkl in Docker — matches the compose volume).
# ML_MODEL_PATH=
ML_CONTAMINATION=0.05

# --- Correlation / risk worker ---
CORRELATION_WINDOW_MINUTES=15
CORRELATION_MIN_ALERTS_FOR_ESCALATION=3
CORRELATION_POLL_INTERVAL_SECONDS=30
# Set to false ONLY when running multiple backend replicas (e.g. Kubernetes
# with replicas > 1) and using the k8s CronJob instead — see k8s/README.md.
ENABLE_EMBEDDED_CORRELATION_WORKER=true
